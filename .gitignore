# Node / pnpm
node_modules/
*.tsbuildinfo
dist/
build/
coverage/

# Python（services/audio-ai-worker）
.venv/
__pycache__/
*.pyc
.ruff_cache/
.mypy_cache/

# C#（mods/stardew-mcp-mod）
mods/**/bin/
mods/**/obj/

# 运行期本地数据与缓存（严禁入库）
data/
*.sqlite3
*.db
cache/
recordings/

# 密钥与环境变量
.env
.env.*
!.env.example

# 编辑器与系统
.DS_Store
.idea/
.vscode/
*.log

# E2E 截图等验证产物（本地留证，不入库）
artifacts/

# 构建包与本地工具缓存
release/
.v2c/
.zcode/
apps/desktop-host/.v2c/

# 桌宠随包素材（T-M6-45）：约 2GB 二进制，由 `pnpm sync:pet-packs` 幂等拉取后
# 经 electron-builder extraResources 随安装包分发；不入 Git（上游许可见 THIRD_PARTY_NOTICES §3）
assets/pet-packs/*
!assets/pet-packs/README.md
!assets/pet-packs/SYNC-MANIFEST.json
mods/stardew-avatar-sync/bin/
mods/stardew-avatar-sync/obj/
mods/stardew-avatar-sync/publish/*.dll
mods/stardew-avatar-sync/publish/*.pdb

# 代理一次性调查与编辑备份（正式报告见 recon/，已入库）
.recon/
.zwork/
docs/*.bak-*

# verify:gate 失败留档（原始输出，含本机路径，不入库）
.verify-gate/
