{
  "name": "ai-vtuber-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "AI 桌宠与虚拟主播工作台 —— 傲娇干饭蓝鲸女仆「小鲸（大肥鱼）」：桌面桌宠 × 星露谷共玩 × 抖音直播中控，100% 本地优先",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint:deps": "depcruise packages apps services tools --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "gen:contracts": "tsx tools/scripts/gen-contracts.ts",
    "py:ruff": "uv run --quiet --with ruff ruff check services/audio-ai-worker",
    "py:mypy": "uv run --quiet --with mypy --with pydantic mypy --strict services/audio-ai-worker/protocol_models.py",
    "py:type": "pnpm py:ruff && pnpm py:mypy",
    "py:test": "uv run --quiet --with pytest --with pydantic pytest services/audio-ai-worker/test_protocol_models.py -q",
    "py:check": "pnpm py:type && pnpm py:test",
    "verify:gate": "node tools/scripts/verify-gate.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  }
}
