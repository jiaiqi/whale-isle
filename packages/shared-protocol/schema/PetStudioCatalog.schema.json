{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PetStudioCatalog",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/PetStudioCatalog",
  "$defs": {
    "PetStudioCatalog": {
      "type": "object",
      "properties": {
        "generatedAt": {
          "default": "",
          "type": "string"
        },
        "packs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "minLength": 1
              },
              "catalogId": {
                "type": "string",
                "minLength": 1
              },
              "displayName": {
                "type": "string",
                "minLength": 1
              },
              "installed": {
                "default": false,
                "type": "boolean"
              },
              "actionCount": {
                "default": 0,
                "type": "integer",
                "minimum": 0
              },
              "audioClipCount": {
                "default": 0,
                "type": "integer",
                "minimum": 0
              },
              "idleClipId": {
                "default": "",
                "type": "string"
              }
            },
            "required": [
              "slug",
              "catalogId",
              "displayName"
            ],
            "additionalProperties": false
          }
        },
        "actions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "minLength": 1
              },
              "packId": {
                "type": "string",
                "minLength": 1
              },
              "displayName": {
                "default": "",
                "type": "string"
              },
              "clipId": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "default": "小动作",
                "type": "string"
              },
              "frameCount": {
                "default": 0,
                "type": "integer",
                "minimum": 0
              },
              "columns": {
                "default": 0,
                "type": "integer",
                "minimum": 0
              },
              "rows": {
                "default": 0,
                "type": "integer",
                "minimum": 0
              },
              "frameWidth": {
                "default": 640,
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "frameHeight": {
                "default": 360,
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "sampleFps": {
                "default": 12,
                "type": "number",
                "exclusiveMinimum": 0
              },
              "hasAudio": {
                "default": false,
                "type": "boolean"
              },
              "spriteUrl": {
                "default": "",
                "type": "string"
              },
              "audioUrl": {
                "default": "",
                "type": "string"
              }
            },
            "required": [
              "slug",
              "packId",
              "clipId"
            ],
            "additionalProperties": false
          }
        },
        "slots": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "packId": {
                "type": "string",
                "minLength": 1
              },
              "slot": {
                "type": "string",
                "enum": [
                  "idle",
                  "walk",
                  "eat_rice",
                  "happy_maid",
                  "thinking_tail_wag",
                  "rage_spray",
                  "clumsy_panic",
                  "game_focus",
                  "sing_stage",
                  "hungry_lazy",
                  "sleep_mute"
                ]
              },
              "clipIds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "packId",
              "slot"
            ],
            "additionalProperties": false
          }
        },
        "skins": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "outfit": {
                "default": "",
                "type": "string"
              },
              "accent": {
                "default": "",
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "base",
                  "skin",
                  "egg"
                ]
              },
              "previewUrl": {
                "default": "",
                "type": "string"
              },
              "frameCount": {
                "default": 0,
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "name",
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "fonts": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "label",
              "file",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "errors": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
