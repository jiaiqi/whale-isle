{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PetAvatarManifest",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/PetAvatarManifest",
  "$defs": {
    "PetAvatarManifest": {
      "type": "object",
      "properties": {
        "petId": {
          "type": "string"
        },
        "renderer": {
          "type": "string",
          "enum": [
            "webm-alpha",
            "live2d",
            "sprite-sheet"
          ]
        },
        "licenseScope": {
          "type": "string",
          "enum": [
            "DEV_ONLY_NON_COMMERCIAL",
            "COMMERCIAL_READY"
          ]
        },
        "attribution": {
          "default": "",
          "type": "string"
        },
        "width": {
          "default": 640,
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        },
        "height": {
          "default": 360,
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        },
        "footlineRatio": {
          "default": 0.92,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "defaultAction": {
          "default": "idle",
          "type": "string",
          "enum": [
            "idle",
            "walk",
            "eat_rice",
            "happy_maid",
            "thinking_tail_wag",
            "rage_spray",
            "clumsy_panic",
            "game_focus",
            "sing_stage",
            "hungry_lazy",
            "sleep_mute"
          ]
        },
        "actions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actionState": {
                "type": "string",
                "enum": [
                  "idle",
                  "walk",
                  "eat_rice",
                  "happy_maid",
                  "thinking_tail_wag",
                  "rage_spray",
                  "clumsy_panic",
                  "game_focus",
                  "sing_stage",
                  "hungry_lazy",
                  "sleep_mute"
                ]
              },
              "clips": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "clipId": {
                      "type": "string"
                    },
                    "webmPath": {
                      "type": "string",
                      "minLength": 1
                    },
                    "loop": {
                      "default": true,
                      "type": "boolean"
                    },
                    "playbackRate": {
                      "default": 1,
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 4
                    },
                    "fps": {
                      "default": 30,
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 120
                    },
                    "weight": {
                      "default": 1,
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "clipId",
                    "webmPath"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "actionState",
              "clips"
            ],
            "additionalProperties": false
          }
        },
        "ambientPool": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "clipId": {
                "type": "string"
              },
              "webmPath": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "default": "小动作",
                "type": "string"
              },
              "weight": {
                "default": 10,
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "clipId",
              "webmPath"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "petId",
        "renderer",
        "licenseScope",
        "actions"
      ],
      "additionalProperties": false
    }
  }
}
