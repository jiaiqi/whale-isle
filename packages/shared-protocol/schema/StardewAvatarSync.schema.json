{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StardewAvatarSync",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/StardewAvatarSync",
  "$defs": {
    "StardewAvatarSync": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "characterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "preset": {
          "type": "object",
          "properties": {
            "hair": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 300
            },
            "hairColor": {
              "default": "#8a5a2b",
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "shirt": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 300
            },
            "pantsColor": {
              "default": "#3b5bdb",
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "skin": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 30
            },
            "hatId": {
              "default": -1,
              "type": "integer",
              "minimum": -1,
              "maximum": 300
            }
          },
          "additionalProperties": false
        },
        "spriteSheetPath": {
          "type": "string",
          "maxLength": 260
        },
        "spriteTier": {
          "type": "string",
          "enum": [
            "1x",
            "2x",
            "4x"
          ]
        },
        "liveliness": {
          "default": true,
          "type": "boolean"
        },
        "syncDisplayName": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "characterId",
        "displayName",
        "preset"
      ],
      "additionalProperties": false
    }
  }
}
