{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StardewModsSnapshot",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/StardewModsSnapshot",
  "$defs": {
    "StardewModsSnapshot": {
      "type": "object",
      "properties": {
        "modsDir": {
          "type": "string",
          "minLength": 1
        },
        "exists": {
          "type": "boolean"
        },
        "mods": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "folderName": {
                "type": "string",
                "minLength": 1
              },
              "uniqueId": {
                "default": "",
                "type": "string"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "author": {
                "default": "",
                "type": "string"
              },
              "version": {
                "default": "",
                "type": "string"
              },
              "description": {
                "default": "",
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "contentType": {
                "default": "",
                "type": "string"
              },
              "minimumApiVersion": {
                "default": "",
                "type": "string"
              },
              "parseError": {
                "default": "",
                "type": "string"
              }
            },
            "required": [
              "folderName",
              "name",
              "enabled"
            ],
            "additionalProperties": false
          }
        },
        "smapiVersion": {
          "default": "",
          "type": "string"
        },
        "scannedAt": {
          "type": "number"
        }
      },
      "required": [
        "modsDir",
        "exists",
        "scannedAt"
      ],
      "additionalProperties": false
    }
  }
}
