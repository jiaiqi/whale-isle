{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceLocator",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/EvidenceLocator",
  "$defs": {
    "EvidenceLocator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "startLine": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "endLine": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "startLine",
            "endLine"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "web"
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "selector": {
              "type": "string",
              "minLength": 1
            },
            "quote": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "video"
            },
            "startMs": {
              "type": "integer",
              "minimum": 0
            },
            "endMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "startMs",
            "endMs"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pdf"
            },
            "page": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "page"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "image-region"
            },
            "x": {
              "type": "number",
              "minimum": 0
            },
            "y": {
              "type": "number",
              "minimum": 0
            },
            "w": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "h": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "x",
            "y",
            "w",
            "h"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
