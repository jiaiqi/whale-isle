{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AudioPlaybackLease",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/AudioPlaybackLease",
  "$defs": {
    "AudioPlaybackLease": {
      "type": "object",
      "properties": {
        "leaseId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceModule": {
          "type": "string",
          "enum": [
            "persona-talk",
            "svc-singing",
            "reflex-interrupt",
            "system-alert"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "P0_INTERRUPT",
            "P1_CADENCE",
            "P2_IDLE"
          ]
        },
        "ttlMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 300000
        },
        "emotionTag": {
          "type": "string",
          "enum": [
            "sweet_normal",
            "tsundere_refuse",
            "rage_spray",
            "lazy_yawn",
            "happy_rice"
          ]
        },
        "textSubtitle": {
          "type": "string"
        },
        "innerThoughtText": {
          "type": "string"
        },
        "audioUrlOrBase64": {
          "type": "string"
        },
        "actionState": {
          "type": "string",
          "enum": [
            "idle",
            "walk",
            "eat_rice",
            "happy_maid",
            "thinking_tail_wag",
            "rage_spray",
            "clumsy_panic",
            "game_focus",
            "sing_stage",
            "hungry_lazy",
            "sleep_mute"
          ]
        }
      },
      "required": [
        "leaseId",
        "sourceModule",
        "priority",
        "ttlMs",
        "emotionTag",
        "textSubtitle",
        "audioUrlOrBase64",
        "actionState"
      ],
      "additionalProperties": false
    }
  }
}
