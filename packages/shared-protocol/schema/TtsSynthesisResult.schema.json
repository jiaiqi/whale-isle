{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TtsSynthesisResult",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/TtsSynthesisResult",
  "$defs": {
    "TtsSynthesisResult": {
      "type": "object",
      "properties": {
        "synthId": {
          "type": "string",
          "format": "uuid"
        },
        "emotionTag": {
          "type": "string",
          "enum": [
            "sweet_normal",
            "tsundere_refuse",
            "rage_spray",
            "lazy_yawn",
            "happy_rice"
          ]
        },
        "refAudioPath": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "degraded": {
          "default": false,
          "type": "boolean"
        },
        "format": {
          "type": "string",
          "enum": [
            "wav",
            "mp3",
            "ogg"
          ]
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "audioBase64": {
          "type": "string",
          "minLength": 1
        },
        "lipEnvelope": {
          "type": "object",
          "properties": {
            "visemes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "viseme": {
                    "type": "string",
                    "enum": [
                      "closed",
                      "wide",
                      "round",
                      "open",
                      "teeth"
                    ]
                  },
                  "startMs": {
                    "type": "number",
                    "minimum": 0
                  },
                  "durationMs": {
                    "type": "number",
                    "minimum": 0
                  },
                  "amplitude": {
                    "default": 0.6,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "viseme",
                  "startMs",
                  "durationMs"
                ],
                "additionalProperties": false
              }
            },
            "totalDurationMs": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "visemes",
            "totalDurationMs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "synthId",
        "emotionTag",
        "refAudioPath",
        "backend",
        "format",
        "durationMs",
        "audioBase64",
        "lipEnvelope"
      ],
      "additionalProperties": false
    }
  }
}
