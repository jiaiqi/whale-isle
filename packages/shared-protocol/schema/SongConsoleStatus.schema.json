{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SongConsoleStatus",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/SongConsoleStatus",
  "$defs": {
    "SongConsoleStatus": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "characterId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "state": {
          "type": "string",
          "enum": [
            "idle",
            "preparing",
            "streaming",
            "completing",
            "completed",
            "rejected",
            "unavailable",
            "cancelled"
          ]
        },
        "stage": {
          "type": "string",
          "enum": [
            "rights_check",
            "blacklist_check",
            "cache_lookup",
            "cache_hit",
            "separating",
            "slicing",
            "converting",
            "mixing",
            "prebuffer_ready",
            "streaming",
            "completing",
            "completed",
            "rejected",
            "unavailable",
            "cancelled"
          ]
        },
        "songId": {
          "type": "string",
          "minLength": 1
        },
        "songTitle": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "enum": [
            "private_desktop",
            "livestream_public",
            "commercial_distribution"
          ]
        },
        "rightsCheck": {
          "type": "object",
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "channel": {
              "type": "string",
              "enum": [
                "private_desktop",
                "livestream_public",
                "commercial_distribution"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "requiresAttribution": {
              "type": "boolean"
            }
          },
          "required": [
            "allowed",
            "channel",
            "reasons",
            "requiresAttribution"
          ],
          "additionalProperties": false
        },
        "cacheKey": {
          "type": "string",
          "minLength": 1
        },
        "cacheHit": {
          "default": false,
          "type": "boolean"
        },
        "cacheLookupMs": {
          "type": "number",
          "minimum": 0
        },
        "rejectionReason": {
          "type": "string"
        },
        "unavailableReason": {
          "type": "string"
        },
        "missingCapabilities": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prebufferPath": {
          "type": "string"
        },
        "prebufferDurationMs": {
          "type": "integer",
          "minimum": 0
        },
        "finalPath": {
          "type": "string"
        },
        "totalDurationMs": {
          "type": "integer",
          "minimum": 0
        },
        "completedSlices": {
          "default": 0,
          "type": "integer",
          "minimum": 0
        },
        "totalSlices": {
          "default": 0,
          "type": "integer",
          "minimum": 0
        },
        "backgroundJobId": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "requestId",
        "characterId",
        "state",
        "stage",
        "songId",
        "songTitle",
        "channel",
        "rightsCheck",
        "cacheKey",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  }
}
