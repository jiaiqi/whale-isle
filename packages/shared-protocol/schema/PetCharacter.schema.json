{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PetCharacter",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/PetCharacter",
  "$defs": {
    "PetCharacter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "manifestPath": {
          "type": "string",
          "minLength": 1
        },
        "personaPrompt": {
          "type": "string",
          "minLength": 1
        },
        "voiceId": {
          "default": "qiaopi_mengmei",
          "type": "string"
        },
        "voiceRatePercent": {
          "default": 100,
          "type": "number",
          "minimum": 50,
          "maximum": 200
        },
        "voicePitchMul": {
          "default": 1,
          "type": "number",
          "minimum": 1,
          "maximum": 1.6
        },
        "packId": {
          "default": "",
          "type": "string"
        },
        "actionCount": {
          "default": 0,
          "type": "integer",
          "minimum": 0
        },
        "audioClipCount": {
          "default": 0,
          "type": "integer",
          "minimum": 0
        },
        "anchorRatio": {
          "default": 0.5,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "licenseScope": {
          "default": "DEV_ONLY_NON_COMMERCIAL",
          "type": "string",
          "enum": [
            "DEV_ONLY_NON_COMMERCIAL",
            "COMMERCIAL_READY"
          ]
        },
        "builtin": {
          "default": false,
          "type": "boolean"
        },
        "skins": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "outfit": {
                "default": "",
                "type": "string"
              },
              "accent": {
                "default": "",
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "base",
                  "skin",
                  "egg"
                ]
              },
              "previewUrl": {
                "default": "",
                "type": "string"
              },
              "frameCount": {
                "default": 0,
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "name",
              "kind"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "displayName",
        "manifestPath",
        "personaPrompt"
      ],
      "additionalProperties": false
    }
  }
}
