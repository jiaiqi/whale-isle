{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TerrariaBridgeConfig",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/TerrariaBridgeConfig",
  "$defs": {
    "TerrariaBridgeConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "endpoint": {
          "default": "http://127.0.0.1:18090",
          "type": "string",
          "format": "uri"
        },
        "freezeWhileThinking": {
          "default": true,
          "type": "boolean"
        },
        "takeoverReacquireMs": {
          "default": 8000,
          "type": "integer",
          "minimum": 1000
        }
      },
      "additionalProperties": false
    }
  }
}
