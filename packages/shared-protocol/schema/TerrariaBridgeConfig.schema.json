{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TerrariaBridgeConfig",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/TerrariaBridgeConfig",
  "$defs": {
    "TerrariaBridgeConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "default": "http://127.0.0.1:18090"
        },
        "freezeWhileThinking": {
          "type": "boolean",
          "default": true
        },
        "takeoverReacquireMs": {
          "type": "integer",
          "minimum": 1000,
          "default": 8000
        }
      },
      "additionalProperties": false
    }
  }
}
