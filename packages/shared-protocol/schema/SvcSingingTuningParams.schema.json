        "rvcModelPath": {
          "default": "",
          "type": "string"
        },
        "indexPath": {
          "default": "",
          "type": "string"
        },
        "pitchShiftSemitones": {
          "default": 0,
          "type": "integer",
          "minimum": -12,
          "maximum": 12
        },
        "indexRate": {
          "default": 0.75,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "protectVoiceless": {
          "default": 0.33,
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "vocalGainDb": {
          "default": 0,
          "type": "number",
          "minimum": -12,
          "maximum": 12
        },
        "accompanimentGainDb": {
          "default": -3,
          "type": "number",
          "minimum": -24,
          "maximum": 6
        }
      },
      "additionalProperties": false
    }
  }
}
