{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SvcSingingTuningParams",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/SvcSingingTuningParams",
  "$defs": {
    "SvcSingingTuningParams": {
      "type": "object",
