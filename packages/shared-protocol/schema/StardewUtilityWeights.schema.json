{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StardewUtilityWeights",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/StardewUtilityWeights",
  "$defs": {
    "StardewUtilityWeights": {
      "type": "object",
