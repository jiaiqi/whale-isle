        "npcGossipAndTrashCan": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "miningCombat": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "slackingAndScenery": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minStaminaThreshold": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.9
        }
      },
      "required": [
        "farmingProfit",
        "npcGossipAndTrashCan",
        "miningCombat",
        "slackingAndScenery",
        "minStaminaThreshold"
      ],
      "additionalProperties": false
