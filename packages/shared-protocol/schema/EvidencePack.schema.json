{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidencePack",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/EvidencePack",
  "$defs": {
    "EvidencePack": {
      "type": "object",
      "properties": {
        "packId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "materialId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "materialSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "extraction": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "failed",
            "unknown"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "chunks": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "chunkId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "locator": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "text"
                      },
                      "startLine": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                      },
                      "endLine": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "kind",
                      "startLine",
                      "endLine"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "web"
                      },
                      "url": {
                        "type": "string",
                        "minLength": 1
                      },
                      "selector": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "url"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "video"
                      },
                      "startMs": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "endMs": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "kind",
                      "startMs",
                      "endMs"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "pdf"
                      },
                      "page": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "kind",
                      "page"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "image-region"
                      },
                      "x": {
                        "type": "number",
                        "minimum": 0
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0
                      },
                      "w": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "h": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "kind",
                      "x",
                      "y",
                      "w",
                      "h"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "origin": {
                "default": "source",
                "type": "string",
                "enum": [
                  "source",
                  "asr",
                  "ocr",
                  "vision",
                  "derived"
                ]
              }
            },
            "required": [
              "chunkId",
              "locator",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "capturedAt": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "originUri": {
              "type": "string",
              "minLength": 1
            },
            "licenseScope": {
              "type": "string",
              "enum": [
                "owner-authorized",
                "cc-by-nc-sa",
                "cc-by-4.0",
                "apache-2.0",
                "mit",
                "unknown"
              ]
            },
            "licenseNote": {
              "type": "string"
            },
            "readerVersion": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "title",
            "originUri",
            "licenseScope",
            "readerVersion"
          ],
          "additionalProperties": false
        },
        "parameters": {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string",
              "minLength": 1
            },
            "sourceType": {
              "type": "string",
              "enum": [
                "official",
                "wiki",
                "community",
                "video",
                "user",
                "experience"
              ]
            },
            "gameVersion": {
              "type": "string",
              "minLength": 1
            },
            "modContext": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "applicability": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "topic",
            "sourceType"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "packId",
        "materialId",
        "materialSha256",
        "sourceRevision",
        "extraction",
        "digest",
        "chunks",
        "capturedAt",
        "source",
        "parameters"
      ],
      "additionalProperties": false
    }
  }
}
