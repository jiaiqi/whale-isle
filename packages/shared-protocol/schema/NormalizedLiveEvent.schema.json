{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NormalizedLiveEvent",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/NormalizedLiveEvent",
  "$defs": {
    "NormalizedLiveEvent": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "platform": {
          "type": "string",
          "enum": [
            "douyin",
            "bilibili",
            "local-host-input"
          ]
        },
        "eventType": {
          "type": "string",
          "enum": [
            "DANMAKU",
            "GIFT",
            "LIKE",
            "FOLLOW",
            "ENTER_ROOM",
            "SONG_REQUEST",
            "VOTE_CHOICE"
          ]
        },
        "sender": {
          "type": "object",
          "properties": {
            "uid": {
              "type": "string"
            },
            "nickname": {
              "type": "string"
            },
            "intimacyScore": {
              "default": 0,
              "type": "number"
            },
            "grudgeTags": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "uid",
            "nickname"
          ],
          "additionalProperties": false
        },
        "payload": {
          "type": "object",
          "properties": {
            "rawText": {
              "type": "string"
            },
            "sanitizedText": {
              "type": "string"
            },
            "mergedCount": {
              "default": 1,
              "type": "integer"
            },
            "giftName": {
              "type": "string"
            },
            "giftDiamondValue": {
              "type": "number",
              "minimum": 0
            },
            "likeCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            },
            "giftCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "songTitle": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "assignedPriority": {
          "type": "string",
          "enum": [
            "P0_INTERRUPT",
            "P1_CADENCE",
            "P2_IDLE"
          ]
        },
        "timestamp": {
          "type": "number"
        }
      },
      "required": [
        "eventId",
        "platform",
        "eventType",
        "sender",
        "payload",
        "assignedPriority",
        "timestamp"
      ],
      "additionalProperties": false
    }
  }
}
