{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnowledgeExecuteInput",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/KnowledgeExecuteInput",
  "$defs": {
    "KnowledgeExecuteInput": {
      "type": "object",
      "properties": {
        "knowledgeId": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "args": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        }
      },
      "required": [
        "knowledgeId",
        "tool"
      ],
      "additionalProperties": false
    }
  }
}
