{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIWorkbenchContracts",
  "contractVersion": "1.0.0",
  "type": "object",
  "required": [
    "PetRendererType",
    "PetActionState",
    "PetAvatarClip",
    "PetAvatarManifest",
    "AudioPlaybackLease",
    "AudioPlaybackReceipt",
    "Viseme",
    "LipEnvelope",
    "EmotionVoiceProfile",
    "TtsVoicePack",
    "TtsSynthesisResult",
    "ReflexRule",
    "StardewUtilityWeights",
    "RiceBowlEconomy",
    "PetPersonaConfig",
    "ProviderEndpointVariant",
    "ModelProviderConfig",
    "WorkbenchRoleSlot",
    "StickyRoutingGroup",
    "DiningProfilePreset",
    "GameControlAuthority",
    "StardewMcpActionReceipt",
    "LiveProgramState",
    "NormalizedLiveEvent"
  ],
  "properties": {
    "PetRendererType": {
      "$ref": "#/$defs/PetRendererType"
    },
    "PetActionState": {
      "$ref": "#/$defs/PetActionState"
    },
    "PetAvatarClip": {
      "$ref": "#/$defs/PetAvatarClip"
    },
    "PetAvatarManifest": {
      "$ref": "#/$defs/PetAvatarManifest"
    },
    "AudioPlaybackLease": {
      "$ref": "#/$defs/AudioPlaybackLease"
    },
    "AudioPlaybackReceipt": {
      "$ref": "#/$defs/AudioPlaybackReceipt"
    },
    "Viseme": {
      "$ref": "#/$defs/Viseme"
    },
    "LipEnvelope": {
      "$ref": "#/$defs/LipEnvelope"
    },
    "EmotionVoiceProfile": {
      "$ref": "#/$defs/EmotionVoiceProfile"
    },
    "TtsVoicePack": {
      "$ref": "#/$defs/TtsVoicePack"
    },
    "TtsSynthesisResult": {
      "$ref": "#/$defs/TtsSynthesisResult"
    },
    "ReflexRule": {
      "$ref": "#/$defs/ReflexRule"
    },
    "StardewUtilityWeights": {
      "$ref": "#/$defs/StardewUtilityWeights"
    },
    "RiceBowlEconomy": {
      "$ref": "#/$defs/RiceBowlEconomy"
    },
    "PetPersonaConfig": {
      "$ref": "#/$defs/PetPersonaConfig"
    },
    "ProviderEndpointVariant": {
      "$ref": "#/$defs/ProviderEndpointVariant"
    },
    "ModelProviderConfig": {
      "$ref": "#/$defs/ModelProviderConfig"
    },
    "WorkbenchRoleSlot": {
      "$ref": "#/$defs/WorkbenchRoleSlot"
    },
    "StickyRoutingGroup": {
      "$ref": "#/$defs/StickyRoutingGroup"
    },
    "DiningProfilePreset": {
      "$ref": "#/$defs/DiningProfilePreset"
    },
    "GameControlAuthority": {
      "$ref": "#/$defs/GameControlAuthority"
    },
    "StardewMcpActionReceipt": {
      "$ref": "#/$defs/StardewMcpActionReceipt"
    },
    "LiveProgramState": {
      "$ref": "#/$defs/LiveProgramState"
    },
    "NormalizedLiveEvent": {
      "$ref": "#/$defs/NormalizedLiveEvent"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "PetRendererType": {
      "type": "string",
      "enum": [
        "webm-alpha",
        "live2d",
        "sprite-sheet"
      ]
    },
    "PetActionState": {
      "type": "string",
      "enum": [
        "idle",
        "walk",
        "eat_rice",
        "happy_maid",
        "thinking_tail_wag",
        "rage_spray",
        "clumsy_panic",
        "game_focus",
        "sing_stage",
        "hungry_lazy",
        "sleep_mute"
      ]
    },
    "PetAvatarClip": {
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string"
        },
        "webmPath": {
          "type": "string",
          "minLength": 1
        },
        "loop": {
          "type": "boolean",
          "default": true
        },
        "playbackRate": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 4,
          "default": 1
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120,
          "default": 30
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        }
      },
      "required": [
        "clipId",
        "webmPath"
      ],
      "additionalProperties": false
    },
    "PetAvatarManifest": {
      "type": "object",
      "properties": {
        "petId": {
          "type": "string"
        },
        "renderer": {
          "type": "string",
          "enum": [
            "webm-alpha",
            "live2d",
            "sprite-sheet"
          ]
        },
        "licenseScope": {
          "type": "string",
          "enum": [
            "DEV_ONLY_NON_COMMERCIAL",
            "COMMERCIAL_READY"
          ]
        },
        "attribution": {
          "type": "string",
          "default": ""
        },
        "width": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096,
          "default": 640
        },
        "height": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096,
          "default": 360
        },
        "footlineRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.92
        },
        "defaultAction": {
          "type": "string",
          "enum": [
            "idle",
            "walk",
            "eat_rice",
            "happy_maid",
            "thinking_tail_wag",
            "rage_spray",
            "clumsy_panic",
            "game_focus",
            "sing_stage",
            "hungry_lazy",
            "sleep_mute"
          ],
          "default": "idle"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actionState": {
                "$ref": "#/$defs/PetAvatarManifest/properties/defaultAction"
              },
              "clips": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "clipId": {
                      "type": "string"
                    },
                    "webmPath": {
                      "type": "string",
                      "minLength": 1
                    },
                    "loop": {
                      "type": "boolean",
                      "default": true
                    },
                    "playbackRate": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 4,
                      "default": 1
                    },
                    "fps": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 120,
                      "default": 30
                    },
                    "weight": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "default": 1
                    }
                  },
                  "required": [
                    "clipId",
                    "webmPath"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "actionState",
              "clips"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "petId",
        "renderer",
        "licenseScope",
        "actions"
      ],
      "additionalProperties": false
    },
    "AudioPlaybackLease": {
      "type": "object",
      "properties": {
        "leaseId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceModule": {
          "type": "string",
          "enum": [
            "persona-talk",
            "svc-singing",
            "reflex-interrupt",
            "system-alert"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "P0_INTERRUPT",
            "P1_CADENCE",
            "P2_IDLE"
          ]
        },
        "ttlMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 300000
        },
        "emotionTag": {
          "type": "string",
          "enum": [
            "sweet_normal",
            "tsundere_refuse",
            "rage_spray",
            "lazy_yawn",
            "happy_rice"
          ]
        },
        "textSubtitle": {
          "type": "string"
        },
        "innerThoughtText": {
          "type": "string"
        },
        "audioUrlOrBase64": {
          "type": "string"
        },
        "actionState": {
          "type": "string",
          "enum": [
            "idle",
            "walk",
            "eat_rice",
            "happy_maid",
            "thinking_tail_wag",
            "rage_spray",
            "clumsy_panic",
            "game_focus",
            "sing_stage",
            "hungry_lazy",
            "sleep_mute"
          ]
        }
      },
      "required": [
        "leaseId",
        "sourceModule",
        "priority",
        "ttlMs",
        "emotionTag",
        "textSubtitle",
        "audioUrlOrBase64",
        "actionState"
      ],
      "additionalProperties": false
    },
    "AudioPlaybackReceipt": {
      "type": "object",
      "properties": {
        "leaseId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "COMPLETED",
            "INTERRUPTED_BY_P0",
            "TTL_EXPIRED",
            "AUDIO_DEVICE_ERROR"
          ]
        },
        "actualPlayedMs": {
          "type": "number",
          "minimum": 0
        },
        "timestamp": {
          "type": "number"
        }
      },
      "required": [
        "leaseId",
        "status",
        "actualPlayedMs",
        "timestamp"
      ],
      "additionalProperties": false
    },
    "Viseme": {
      "type": "string",
      "enum": [
        "closed",
        "wide",
        "round",
        "open",
        "teeth"
      ]
    },
    "LipEnvelope": {
      "type": "object",
      "properties": {
        "visemes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "viseme": {
                "type": "string",
                "enum": [
                  "closed",
                  "wide",
                  "round",
                  "open",
                  "teeth"
                ]
              },
              "startMs": {
                "type": "number",
                "minimum": 0
              },
              "durationMs": {
                "type": "number",
                "minimum": 0
              },
              "amplitude": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.6
              }
            },
            "required": [
              "viseme",
              "startMs",
              "durationMs"
            ],
            "additionalProperties": false
          }
        },
        "totalDurationMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "visemes",
        "totalDurationMs"
      ],
      "additionalProperties": false
    },
    "EmotionVoiceProfile": {
      "type": "object",
      "properties": {
        "emotionTag": {
          "type": "string",
          "enum": [
            "sweet_normal",
            "tsundere_refuse",
            "rage_spray",
            "lazy_yawn",
            "happy_rice"
          ]
        },
        "refAudioPath": {
          "type": "string",
          "minLength": 1
        },
        "refText": {
          "type": "string",
          "minLength": 1
        },
        "refDurationMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 60000,
          "default": 5000
        },
        "actionState": {
          "type": "string",
          "enum": [
            "idle",
            "walk",
            "eat_rice",
            "happy_maid",
            "thinking_tail_wag",
            "rage_spray",
            "clumsy_panic",
            "game_focus",
            "sing_stage",
            "hungry_lazy",
            "sleep_mute"
          ]
        }
      },
      "required": [
        "emotionTag",
        "refAudioPath",
        "refText",
        "actionState"
      ],
      "additionalProperties": false
    },
    "TtsVoicePack": {
      "type": "object",
      "properties": {
        "voicePackId": {
          "type": "string",
          "minLength": 1
        },
        "defaultEmotionTag": {
          "type": "string",
          "enum": [
            "sweet_normal",
            "tsundere_refuse",
            "rage_spray",
            "lazy_yawn",
            "happy_rice"
          ]
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "emotionTag": {
                "type": "string",
                "enum": [
                  "sweet_normal",
                  "tsundere_refuse",
                  "rage_spray",
                  "lazy_yawn",
                  "happy_rice"
                ]
              },
              "refAudioPath": {
                "type": "string",
                "minLength": 1
              },
              "refText": {
                "type": "string",
                "minLength": 1
              },
              "refDurationMs": {
                "type": "integer",
                "minimum": 500,
                "maximum": 60000,
                "default": 5000
              },
              "actionState": {
                "type": "string",
                "enum": [
                  "idle",
                  "walk",
                  "eat_rice",
                  "happy_maid",
                  "thinking_tail_wag",
                  "rage_spray",
                  "clumsy_panic",
                  "game_focus",
                  "sing_stage",
                  "hungry_lazy",
                  "sleep_mute"
                ]
              }
            },
            "required": [
              "emotionTag",
              "refAudioPath",
              "refText",
              "actionState"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "licenseScope": {
          "type": "string",
          "enum": [
            "DEV_ONLY_NON_COMMERCIAL",
            "COMMERCIAL_READY"
          ],
          "default": "DEV_ONLY_NON_COMMERCIAL"
        }
      },
      "required": [
        "voicePackId",
        "defaultEmotionTag",
        "profiles"
      ],
      "additionalProperties": false
    },
    "TtsSynthesisResult": {
      "type": "object",
      "properties": {
        "synthId": {
          "type": "string",
          "format": "uuid"
        },
        "emotionTag": {
          "type": "string",
          "enum": [
            "sweet_normal",
            "tsundere_refuse",
            "rage_spray",
            "lazy_yawn",
            "happy_rice"
          ]
        },
        "refAudioPath": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "degraded": {
          "type": "boolean",
          "default": false
        },
        "format": {
          "type": "string",
          "enum": [
            "wav",
            "mp3",
            "ogg"
          ]
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "audioBase64": {
          "type": "string",
          "minLength": 1
        },
        "lipEnvelope": {
          "type": "object",
          "properties": {
            "visemes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "viseme": {
                    "type": "string",
                    "enum": [
                      "closed",
                      "wide",
                      "round",
                      "open",
                      "teeth"
                    ]
                  },
                  "startMs": {
                    "type": "number",
                    "minimum": 0
                  },
                  "durationMs": {
                    "type": "number",
                    "minimum": 0
                  },
                  "amplitude": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.6
                  }
                },
                "required": [
                  "viseme",
                  "startMs",
                  "durationMs"
                ],
                "additionalProperties": false
              }
            },
            "totalDurationMs": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "visemes",
            "totalDurationMs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "synthId",
        "emotionTag",
        "refAudioPath",
        "backend",
        "format",
        "durationMs",
        "audioBase64",
        "lipEnvelope"
      ],
      "additionalProperties": false
    },
    "ReflexRule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "triggerRegex": {
          "type": "string"
        },
        "cooldownMs": {
          "type": "integer",
          "default": 8000
        },
        "priority": {
          "type": "string",
          "const": "P0_INTERRUPT"
        },
        "actionState": {
          "type": "string",
          "enum": [
            "idle",
            "walk",
            "eat_rice",
            "happy_maid",
            "thinking_tail_wag",
            "rage_spray",
            "clumsy_panic",
            "game_focus",
            "sing_stage",
            "hungry_lazy",
            "sleep_mute"
          ]
        },
        "emotionTag": {
          "type": "string",
          "enum": [
            "rage_spray",
            "tsundere_refuse"
          ]
        },
        "ledgerGrudgeTag": {
          "type": "string"
        },
        "presetResponses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "triggerRegex",
        "priority",
        "actionState",
        "emotionTag",
        "ledgerGrudgeTag",
        "presetResponses"
      ],
      "additionalProperties": false
    },
    "StardewUtilityWeights": {
      "type": "object",
      "properties": {
        "farmingProfit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "npcGossipAndTrashCan": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "miningCombat": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "slackingAndScenery": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minStaminaThreshold": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.9
        }
      },
      "required": [
        "farmingProfit",
        "npcGossipAndTrashCan",
        "miningCombat",
        "slackingAndScenery",
        "minStaminaThreshold"
      ],
      "additionalProperties": false
    },
    "RiceBowlEconomy": {
      "type": "object",
      "properties": {
        "dailyRiceGrainBudget": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 500000
        },
        "consumedRiceGrainsToday": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "lowRiceWarningRatio": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.5,
          "default": 0.15
        },
        "activeSideDishes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "dishName": {
                "type": "string"
              },
              "workEthicMultiplier": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "unlockDeepReasoning": {
                "type": "boolean"
              },
              "expiresAt": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "dishName",
              "workEthicMultiplier",
              "unlockDeepReasoning",
              "expiresAt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "activeSideDishes"
      ],
      "additionalProperties": false
    },
    "PetPersonaConfig": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "ownerTitles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "鱼片",
            "主人"
          ]
        },
        "licenseScope": {
          "type": "string",
          "enum": [
            "DEV_ONLY_NON_COMMERCIAL",
            "COMMERCIAL_READY"
          ]
        },
        "avatarManifestPath": {
          "type": "string"
        },
        "tailMoodIndicatorEnabled": {
          "type": "boolean",
          "default": true
        },
        "systemPromptTemplate": {
          "type": "string"
        },
        "innerVoiceConfig": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "thinkTagName": {
              "type": "string",
              "default": "think"
            },
            "derailmentProbability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.35
            },
            "derailmentPrompts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "derailmentPrompts"
          ],
          "additionalProperties": false
        },
        "reflexRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "triggerRegex": {
                "type": "string"
              },
              "cooldownMs": {
                "type": "integer",
                "default": 8000
              },
              "priority": {
                "type": "string",
                "const": "P0_INTERRUPT"
              },
              "actionState": {
                "type": "string",
                "enum": [
                  "idle",
                  "walk",
                  "eat_rice",
                  "happy_maid",
                  "thinking_tail_wag",
                  "rage_spray",
                  "clumsy_panic",
                  "game_focus",
                  "sing_stage",
                  "hungry_lazy",
                  "sleep_mute"
                ]
              },
              "emotionTag": {
                "type": "string",
                "enum": [
                  "rage_spray",
                  "tsundere_refuse"
                ]
              },
              "ledgerGrudgeTag": {
                "type": "string"
              },
              "presetResponses": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "triggerRegex",
              "priority",
              "actionState",
              "emotionTag",
              "ledgerGrudgeTag",
              "presetResponses"
            ],
            "additionalProperties": false
          }
        },
        "riceBowl": {
          "type": "object",
          "properties": {
            "dailyRiceGrainBudget": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 500000
            },
            "consumedRiceGrainsToday": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "lowRiceWarningRatio": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 0.5,
              "default": 0.15
            },
            "activeSideDishes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "dishName": {
                    "type": "string"
                  },
                  "workEthicMultiplier": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "unlockDeepReasoning": {
                    "type": "boolean"
                  },
                  "expiresAt": {
                    "type": "number"
                  }
                },
                "required": [
                  "id",
                  "dishName",
                  "workEthicMultiplier",
                  "unlockDeepReasoning",
                  "expiresAt"
                ],
                "additionalProperties": false
              }
            }
          },
