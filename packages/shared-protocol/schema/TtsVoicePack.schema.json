{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TtsVoicePack",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/TtsVoicePack",
  "$defs": {
    "TtsVoicePack": {
      "type": "object",
      "properties": {
        "voicePackId": {
          "type": "string",
          "minLength": 1
        },
        "defaultEmotionTag": {
          "type": "string",
          "enum": [
            "sweet_normal",
            "tsundere_refuse",
            "rage_spray",
            "lazy_yawn",
            "happy_rice"
          ]
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "emotionTag": {
                "type": "string",
                "enum": [
                  "sweet_normal",
                  "tsundere_refuse",
                  "rage_spray",
                  "lazy_yawn",
                  "happy_rice"
                ]
              },
              "refAudioPath": {
                "type": "string",
                "minLength": 1
              },
              "refText": {
                "type": "string",
                "minLength": 1
              },
              "refDurationMs": {
                "type": "integer",
                "minimum": 500,
                "maximum": 60000,
                "default": 5000
              },
              "actionState": {
                "type": "string",
                "enum": [
                  "idle",
                  "walk",
                  "eat_rice",
                  "happy_maid",
                  "thinking_tail_wag",
                  "rage_spray",
                  "clumsy_panic",
                  "game_focus",
                  "sing_stage",
                  "hungry_lazy",
                  "sleep_mute"
                ]
              }
            },
            "required": [
              "emotionTag",
              "refAudioPath",
              "refText",
              "actionState"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "licenseScope": {
          "type": "string",
          "enum": [
            "DEV_ONLY_NON_COMMERCIAL",
            "COMMERCIAL_READY"
          ],
          "default": "DEV_ONLY_NON_COMMERCIAL"
        }
      },
      "required": [
        "voicePackId",
        "defaultEmotionTag",
        "profiles"
      ],
      "additionalProperties": false
    }
  }
}
