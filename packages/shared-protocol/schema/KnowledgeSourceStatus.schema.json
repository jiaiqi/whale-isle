{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnowledgeSourceStatus",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/KnowledgeSourceStatus",
  "$defs": {
    "KnowledgeSourceStatus": {
      "type": "object",
      "properties": {
        "sourceId": {
          "default": "envoy",
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "available",
            "unavailable",
            "starting",
            "error"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "materialsRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "materialCount": {
          "default": 0,
          "type": "integer",
          "minimum": 0
        },
        "readOnly": {
          "default": true,
          "type": "boolean",
          "const": true
        },
        "checkedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "state",
        "checkedAt"
      ],
      "additionalProperties": false
    }
  }
}
