{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DstBridgeConfig",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/DstBridgeConfig",
  "$defs": {
    "DstBridgeConfig": {
      "type": "object",
      "properties": {
