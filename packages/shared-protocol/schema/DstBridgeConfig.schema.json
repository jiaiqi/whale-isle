          "default": false,
          "type": "boolean"
        },
        "endpoint": {
          "default": "http://127.0.0.1:18100",
          "type": "string",
          "format": "uri"
        },
        "clusterDir": {
          "default": "",
          "type": "string"
        },
        "pairToken": {
          "default": "",
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
