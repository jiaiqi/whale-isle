{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DstBridgeConfig",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/DstBridgeConfig",
  "$defs": {
    "DstBridgeConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "default": "http://127.0.0.1:18100"
        },
        "clusterDir": {
          "type": "string",
          "default": ""
        },
        "pairToken": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    }
  }
}
