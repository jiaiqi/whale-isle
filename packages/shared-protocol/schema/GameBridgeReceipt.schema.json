{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GameBridgeReceipt",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/GameBridgeReceipt",
  "$defs": {
    "GameBridgeReceipt": {
      "type": "object",
      "properties": {
        "actionId": {
          "type": "string",
          "format": "uuid"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "COMPLETED",
            "FAILED",
            "UNCERTAIN",
            "ABORTED_BY_HUMAN_TAKEOVER"
          ]
        },
        "reason": {
          "type": "string"
        },
        "startedAt": {
          "type": "number"
        },
        "completedAt": {
          "type": "number"
        }
      },
      "required": [
        "actionId",
        "tool",
        "status",
        "startedAt",
        "completedAt"
      ],
      "additionalProperties": false
    }
  }
}
