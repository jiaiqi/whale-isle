{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MemoryNodeView",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/MemoryNodeView",
  "$defs": {
    "MemoryNodeView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "nodeType": {
          "type": "string",
          "enum": [
            "event",
            "entity",
            "concept",
            "summary"
          ]
        },
        "text": {
          "type": "string"
        },
        "importance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pinned": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "number"
        },
        "day": {
          "default": "",
          "type": "string"
        },
        "instanceCount": {
          "default": 1,
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "nodeType",
        "text",
        "importance",
        "pinned",
        "createdAt"
      ],
      "additionalProperties": false
    }
  }
}
