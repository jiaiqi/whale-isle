{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PetWindowPreferencesFile",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/PetWindowPreferencesFile",
  "$defs": {
    "PetWindowPreferencesFile": {
      "type": "object",
      "properties": {
        "version": {
          "default": 1,
          "type": "number",
          "const": 1
        },
        "windows": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "agentId": {
                "type": "string",
                "minLength": 1
              },
              "characterId": {
                "default": "blue-whale-maid",
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "displayId": {
                    "default": "",
                    "type": "string"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "scale": {
                "default": 1,
                "type": "number",
                "minimum": 0.6,
                "maximum": 2
              },
              "locked": {
                "default": false,
                "type": "boolean"
              },
              "visible": {
                "default": true,
                "type": "boolean"
              }
            },
            "required": [
              "agentId",
              "position"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
