{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SongConsoleCapability",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/SongConsoleCapability",
  "$defs": {
    "SongConsoleCapability": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "demucs",
            "rvc",
            "ffmpeg",
            "rmvpe"
          ]
        },
        "ready": {
          "type": "boolean"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "name",
        "ready",
        "detail"
      ],
      "additionalProperties": false
    }
  }
}
