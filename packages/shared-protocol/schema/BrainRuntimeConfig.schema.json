{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrainRuntimeConfig",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/BrainRuntimeConfig",
  "$defs": {
    "BrainRuntimeConfig": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "object",
          "properties": {
            "profileId": {
              "type": "string",
              "enum": [
                "BUDGET_SLACKING",
                "DELUXE_LIVESTREAM",
                "OFFLINE_SURVIVAL"
              ]
            },
            "displayName": {
              "type": "string"
            },
            "roleBindings": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": [
                  "MAIN_PERSONA_BRAIN",
                  "STARDEW_GAME_PLANNER",
                  "TERRARIA_GAME_PLANNER",
                  "DST_GAME_PLANNER",
                  "DANMAKU_FAST_ROUTER",
                  "VISION_STORYBOARD",
                  "VOICE_TTS_SPEECH",
                  "VOICE_SVC_SINGING"
                ]
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "secretMaskingEnabled": {
              "default": true,
              "type": "boolean"
            }
          },
          "required": [
            "profileId",
            "displayName",
            "roleBindings"
          ],
          "additionalProperties": false
        },
        "providerModels": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "providers": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string",
                "enum": [
                  "OFFICIAL_LLM",
                  "AGGREGATOR_LLM",
                  "LOCAL_LLM",
                  "AUDIO_TTS",
                  "AUDIO_SVC"
                ]
              },
              "activeRegion": {
                "default": "CN",
                "type": "string",
                "enum": [
                  "CN",
                  "GLOBAL",
                  "LOCAL"
                ]
              },
              "activePlanType": {
                "default": "PAY_AS_YOU_GO",
                "type": "string",
                "enum": [
                  "PAY_AS_YOU_GO",
                  "CODING_PLAN",
                  "FREE_TIER",
                  "LOCAL_GPU"
                ]
              },
              "variants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "region": {
                      "type": "string",
                      "enum": [
                        "CN",
                        "GLOBAL",
                        "LOCAL"
                      ]
                    },
                    "planType": {
                      "type": "string",
                      "enum": [
                        "PAY_AS_YOU_GO",
                        "CODING_PLAN",
                        "FREE_TIER",
                        "LOCAL_GPU"
                      ]
                    },
                    "baseUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "isFullUrl": {
                      "default": false,
                      "type": "boolean"
                    },
                    "protocol": {
                      "default": "openai",
                      "type": "string",
                      "enum": [
                        "openai",
                        "anthropic"
                      ]
                    }
                  },
                  "required": [
                    "region",
                    "planType",
                    "baseUrl"
                  ],
                  "additionalProperties": false
                }
              },
              "apiKeyMaskedOrRef": {
                "type": "string"
              },
              "activeModelId": {
                "default": "",
                "type": "string"
              },
              "protocol": {
                "default": "openai",
                "type": "string",
                "enum": [
                  "openai",
                  "anthropic"
                ]
              },
              "customParams": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "discoveredModels": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "supportsReasoningThink": {
                      "default": false,
                      "type": "boolean"
                    },
                    "supportsVision": {
                      "default": false,
                      "type": "boolean"
                    },
                    "supportsToolCalling": {
                      "default": true,
                      "type": "boolean"
                    },
                    "inputCostPer1M": {
                      "default": 0,
                      "type": "number",
                      "minimum": 0
                    },
                    "outputCostPer1M": {
                      "default": 0,
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "name",
              "category",
              "variants",
              "apiKeyMaskedOrRef",
              "discoveredModels"
            ],
            "additionalProperties": false
          }
        },
        "allowRuleStandin": {
          "type": "boolean"
        },
        "plannerTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        }
      },
      "required": [
        "profile"
      ],
      "additionalProperties": false
    }
  }
}
