{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkFollowEvent",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/WorkFollowEvent",
  "$defs": {
    "WorkFollowEvent": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "acp",
            "claude",
            "codex",
            "deepseek",
            "gemini",
            "cursor",
            "qwen",
            "kimi",
            "grok"
          ]
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "enum": [
            "start",
            "tool",
            "stop",
            "asking",
            "compact",
            "error"
          ]
        },
        "toolName": {
          "default": "",
          "type": "string",
          "maxLength": 120
        },
        "modelName": {
          "default": "",
          "type": "string",
          "maxLength": 120
        },
        "taskTitle": {
          "default": "",
          "type": "string",
          "maxLength": 120
        },
        "ts": {
          "default": 0,
          "type": "integer",
          "minimum": 0
        },
        "origin": {
          "default": "hook",
          "type": "string",
          "enum": [
            "hook",
            "log-watch",
            "acp",
            "manual"
          ]
        }
      },
      "required": [
        "source",
        "sessionId",
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
