{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PetAvatarClip",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/PetAvatarClip",
  "$defs": {
    "PetAvatarClip": {
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string"
        },
        "webmPath": {
          "type": "string",
          "minLength": 1
        },
        "spriteSheetPath": {
          "type": "string"
        },
        "spriteMetaPath": {
          "type": "string"
        },
        "sprite": {
          "type": "object",
          "properties": {
            "frameWidth": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "frameHeight": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "columns": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "frameCount": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "sampleFps": {
              "default": 12,
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 120
            }
          },
          "required": [
            "frameWidth",
            "frameHeight",
            "columns",
            "frameCount"
          ],
          "additionalProperties": false
        },
        "audioPath": {
          "type": "string"
        },
        "loop": {
          "default": true,
          "type": "boolean"
        },
        "playbackRate": {
          "default": 1,
          "type": "number",
          "minimum": 0.1,
          "maximum": 4
        },
        "fps": {
          "default": 30,
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "weight": {
          "default": 1,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "facing": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        },
        "moving": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "number",
                "exclusiveMinimum": 0
              }
            ],
            "additionalItems": false,
            "minItems": 3,
            "maxItems": 3
          }
        },
        "category": {
          "type": "string"
        }
      },
      "required": [
        "clipId",
        "webmPath"
      ],
      "additionalProperties": false
    }
  }
}
