{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EmotionVoiceProfile",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/EmotionVoiceProfile",
  "$defs": {
    "EmotionVoiceProfile": {
      "type": "object",
      "properties": {
        "emotionTag": {
          "type": "string",
          "enum": [
            "sweet_normal",
            "tsundere_refuse",
            "rage_spray",
            "lazy_yawn",
            "happy_rice"
          ]
        },
        "refAudioPath": {
          "type": "string",
          "minLength": 1
        },
        "refText": {
          "type": "string",
          "minLength": 1
        },
        "refDurationMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 60000,
          "default": 5000
        },
        "actionState": {
          "type": "string",
          "enum": [
            "idle",
            "walk",
            "eat_rice",
            "happy_maid",
            "thinking_tail_wag",
            "rage_spray",
            "clumsy_panic",
            "game_focus",
            "sing_stage",
            "hungry_lazy",
            "sleep_mute"
          ]
        }
      },
      "required": [
        "emotionTag",
        "refAudioPath",
        "refText",
        "actionState"
      ],
      "additionalProperties": false
    }
  }
}
