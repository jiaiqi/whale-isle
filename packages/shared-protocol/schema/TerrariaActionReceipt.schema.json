{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TerrariaActionReceipt",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/TerrariaActionReceipt",
  "$defs": {
    "TerrariaActionReceipt": {
      "type": "object",
      "properties": {
        "actionId": {
          "type": "string",
          "format": "uuid"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "COMPLETED",
            "FAILED",
            "UNCERTAIN",
            "ABORTED_BY_HUMAN_TAKEOVER"
          ]
        },
        "reason": {
          "type": "string"
        },
        "startedAt": {
          "type": "number"
        },
        "completedAt": {
          "type": "number"
        },
        "gameId": {
          "type": "string",
          "const": "terraria"
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "capturedAt": {
              "type": "number"
            },
            "clock": {
              "type": "object",
              "properties": {
                "dayCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "isDay": {
                  "type": "boolean"
                },
                "dayPhase": {
                  "type": "string",
                  "enum": [
                    "dawn",
                    "day",
                    "dusk",
                    "night"
                  ]
                },
                "timeText": {
                  "type": "string"
                },
                "hardMode": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "dayCount",
                "isDay",
                "dayPhase",
                "timeText"
              ],
              "additionalProperties": false
            },
            "player": {
              "type": "object",
              "properties": {
                "hp": {
                  "type": "integer",
                  "minimum": 0
                },
                "hpMax": {
                  "type": "integer",
                  "minimum": 1
                },
                "mana": {
                  "type": "integer",
                  "minimum": 0
                },
                "manaMax": {
                  "type": "integer",
                  "minimum": 1
                },
                "position": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                "facing": {
                  "type": "string",
                  "enum": [
                    "left",
                    "right"
                  ]
                },
                "buffs": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "timeSeconds": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "name",
                      "timeSeconds"
                    ],
                    "additionalProperties": false
                  }
                },
                "inventory": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "slot": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "itemName": {
                        "type": "string"
                      },
                      "stack": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "slot",
                      "itemName",
                      "stack"
                    ],
                    "additionalProperties": false
                  }
                },
                "selectedSlot": {
                  "default": 0,
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "hp",
                "hpMax",
                "mana",
                "manaMax",
                "position",
                "facing"
              ],
              "additionalProperties": false
            },
            "world": {
              "type": "object",
              "properties": {
                "biome": {
                  "type": "string"
                },
                "events": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "downedBosses": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "biome"
              ],
              "additionalProperties": false
            },
            "nearby": {
              "type": "object",
              "properties": {
                "tiles": {
                  "type": "object",
                  "properties": {
                    "originX": {
                      "type": "integer"
                    },
                    "originY": {
                      "type": "integer"
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "legend": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "originX",
                    "originY",
                    "width",
                    "height",
                    "legend",
                    "rows"
                  ],
                  "additionalProperties": false
                },
                "npcs": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "hp": {
                        "type": "number"
                      },
                      "hpMax": {
                        "type": "number"
                      },
                      "position": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "x",
                          "y"
                        ],
                        "additionalProperties": false
                      },
                      "isHostile": {
                        "type": "boolean"
                      },
                      "isBoss": {
                        "default": false,
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "name",
                      "hp",
                      "hpMax",
                      "position",
                      "isHostile"
                    ],
                    "additionalProperties": false
                  }
                },
                "items": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "stack": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "position": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "x",
                          "y"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "name",
                      "stack",
                      "position"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "tiles"
              ],
              "additionalProperties": false
            },
            "danger": {
              "type": "object",
              "properties": {
                "lavaNearby": {
                  "default": false,
                  "type": "boolean"
                },
                "fallingDanger": {
                  "default": false,
                  "type": "boolean"
                },
                "threatLevel": {
                  "default": "safe",
                  "type": "string",
                  "enum": [
                    "safe",
                    "caution",
                    "critical"
                  ]
                }
              },
              "additionalProperties": false
            },
            "control": {
              "type": "object",
              "properties": {
                "authority": {
                  "type": "string",
                  "enum": [
                    "AI_AUTOPILOT",
                    "HUMAN_TAKEOVER_ACTIVE",
                    "PAUSED_BY_PROGRAM"
                  ]
                },
                "isPlayerMovingPhysically": {
                  "type": "boolean"
                }
              },
              "required": [
                "authority",
                "isPlayerMovingPhysically"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "schemaVersion",
            "capturedAt",
            "clock",
            "player",
            "world",
            "nearby",
            "danger",
            "control"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "actionId",
        "tool",
        "status",
        "startedAt",
        "completedAt",
        "gameId"
      ],
      "additionalProperties": false
    }
  }
}
