{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SingingProfile",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/SingingProfile",
  "$defs": {
    "SingingProfile": {
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "characterId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "route": {
          "default": "svc",
          "type": "string",
          "enum": [
            "svc",
            "svs",
            "svs_svc"
          ]
        },
        "voice": {
          "type": "object",
          "properties": {
            "identityId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "displayName": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "enum": [
                "builtin_reference",
                "owner_authorized_recording",
                "licensed_model",
                "dev_baseline"
              ]
            },
            "consentScopes": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "training",
                  "synthesis",
                  "commercial_livestream",
                  "redistribution",
                  "internal_eval_only"
                ]
              }
            },
            "consentEvidenceRef": {
              "default": "",
              "type": "string"
            },
            "minorVoice": {
              "default": false,
              "type": "boolean"
            },
            "guardianConsent": {
              "default": false,
              "type": "boolean"
            },
            "weightLicense": {
              "default": "unknown",
              "type": "string",
              "enum": [
                "commercial_ok",
                "dev_only_non_commercial",
                "unlicensed",
                "unknown"
              ]
            },
            "svcModelPath": {
              "default": "",
              "type": "string"
            },
            "svcIndexPath": {
              "default": "",
              "type": "string"
            },
            "svsVoicebankPath": {
              "default": "",
              "type": "string"
            },
            "notes": {
              "default": "",
              "type": "string"
            }
          },
          "required": [
            "identityId",
            "displayName",
            "source"
          ],
          "additionalProperties": false
        },
        "range": {
          "type": "object",
          "properties": {
            "lowestNote": {
              "type": "string",
              "pattern": "^[A-G]#?\\d$"
            },
            "highestNote": {
              "type": "string",
              "pattern": "^[A-G]#?\\d$"
            },
            "comfortableLow": {
              "type": "string",
              "pattern": "^[A-G]#?\\d$"
            },
            "comfortableHigh": {
              "type": "string",
              "pattern": "^[A-G]#?\\d$"
            }
          },
          "required": [
            "lowestNote",
            "highestNote",
            "comfortableLow",
            "comfortableHigh"
          ],
          "additionalProperties": false
        },
        "style": {
          "type": "object",
          "properties": {
            "vibrato": {
              "default": "light",
              "type": "string",
              "enum": [
                "none",
                "light",
                "medium",
                "strong"
              ]
            },
            "breathiness": {
              "default": 0.3,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "attack": {
              "default": "natural",
              "type": "string",
              "enum": [
                "soft",
                "natural",
                "sharp"
              ]
            },
            "timbreNotes": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "emotionReferenceIds": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "sweet_normal",
              "tsundere_refuse",
              "rage_spray",
              "lazy_yawn",
              "clumsy_panic",
              "happy_rice"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "profileId",
        "characterId",
        "voice",
        "range",
        "style"
      ],
      "additionalProperties": false
    }
  }
}
