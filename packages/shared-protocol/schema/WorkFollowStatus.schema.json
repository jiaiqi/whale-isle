{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkFollowStatus",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/WorkFollowStatus",
  "$defs": {
    "WorkFollowStatus": {
      "type": "object",
      "properties": {
        "mode": {
          "default": "multi",
          "type": "string",
          "enum": [
            "single",
            "multi"
          ]
        },
        "sessions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "sessionId": {
                "type": "string",
                "minLength": 1
              },
              "characterId": {
                "default": "",
                "type": "string"
              },
              "toolCalls": {
                "default": 0,
                "type": "integer",
                "minimum": 0
              },
              "startedAt": {
                "default": 0,
                "type": "integer",
                "minimum": 0
              },
              "lastEventAt": {
                "default": 0,
                "type": "integer",
                "minimum": 0
              },
              "taskTitle": {
                "default": "",
                "type": "string"
              },
              "modelName": {
                "default": "",
                "type": "string"
              },
              "crowned": {
                "default": false,
                "type": "boolean"
              },
              "active": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "source",
              "sessionId"
            ],
            "additionalProperties": false
          }
        },
        "recent": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "toolName": {
                "default": "",
                "type": "string"
              },
              "at": {
                "default": 0,
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "source",
              "kind"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
