{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LipEnvelope",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/LipEnvelope",
  "$defs": {
    "LipEnvelope": {
      "type": "object",
      "properties": {
        "visemes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "viseme": {
                "type": "string",
                "enum": [
                  "closed",
                  "wide",
                  "round",
                  "open",
                  "teeth"
                ]
              },
              "startMs": {
                "type": "number",
                "minimum": 0
              },
              "durationMs": {
                "type": "number",
                "minimum": 0
              },
              "amplitude": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.6
              }
            },
            "required": [
              "viseme",
              "startMs",
              "durationMs"
            ],
            "additionalProperties": false
          }
        },
        "totalDurationMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "visemes",
        "totalDurationMs"
      ],
      "additionalProperties": false
    }
  }
}
