{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PetDesktopPrefs",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/PetDesktopPrefs",
  "$defs": {
    "PetDesktopPrefs": {
      "type": "object",
      "properties": {
        "position": {
          "default": {
            "x": 80,
            "y": 80,
            "displayId": ""
          },
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "displayId": {
              "default": "",
              "type": "string"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "scale": {
          "default": 1,
          "type": "number",
          "minimum": 0.6,
          "maximum": 2
        },
        "dragBehavior": {
          "default": "stick",
          "type": "string",
          "enum": [
            "stick",
            "glide",
            "gravity"
          ]
        },
        "characterId": {
          "default": "blue-whale-maid",
          "type": "string"
        },
        "mcpEndpointId": {
          "default": "default",
          "type": "string"
        },
        "powerSaverEnabled": {
          "default": true,
          "type": "boolean"
        },
        "shortcutHideEnabled": {
          "default": true,
          "type": "boolean"
        },
        "autoHideFullscreen": {
          "default": true,
          "type": "boolean"
        },
        "sfxEnabled": {
          "default": true,
          "type": "boolean"
        },
        "sfxVolume": {
          "default": 0.7,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
