{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PetDesktopPrefs",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/PetDesktopPrefs",
  "$defs": {
    "PetDesktopPrefs": {
      "type": "object",
      "properties": {
        "liveEngagement": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "showRules": {
              "default": true,
              "type": "boolean"
            },
            "showLikeGoal": {
              "default": true,
              "type": "boolean"
            },
            "showLeaderboard": {
              "default": true,
              "type": "boolean"
            },
            "likeGoal": {
              "default": 15000,
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            },
            "resetAfterMs": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 86400000
            },
            "globalCooldownMs": {
              "default": 5000,
              "type": "integer",
              "minimum": 1000,
              "maximum": 300000
            },
            "leaderboardMetric": {
              "default": "count",
              "type": "string",
              "enum": [
                "count",
                "value"
              ]
            },
            "topN": {
              "default": 5,
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "rules": {
              "default": [
                {
                  "id": "welcome",
                  "enabled": true,
                  "trigger": "follow",
                  "minGiftValue": 0,
                  "cooldownMs": 120000,
                  "action": {
                    "type": "bubble",
                    "text": "欢迎新朋友！一起看看今天的节目吧。"
                  }
                },
                {
                  "id": "gift-thanks",
                  "enabled": true,
                  "trigger": "gift",
                  "minGiftValue": 0,
                  "cooldownMs": 120000,
                  "action": {
                    "type": "bubble",
                    "text": "收到这份心意啦，谢谢你的支持！"
                  }
                },
                {
                  "id": "like-celebration",
                  "enabled": true,
                  "trigger": "like_goal",
                  "minGiftValue": 0,
                  "cooldownMs": 120000,
                  "action": {
                    "type": "bubble",
                    "text": "今天的点赞目标达成，送上小鲸的感谢！"
                  }
                }
              ],
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 48
                  },
                  "enabled": {
                    "default": true,
                    "type": "boolean"
                  },
                  "trigger": {
                    "type": "string",
                    "enum": [
                      "follow",
                      "gift",
                      "like_goal"
                    ]
                  },
                  "minGiftValue": {
                    "default": 0,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "cooldownMs": {
                    "default": 120000,
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 86400000
                  },
                  "action": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "bubble"
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                          }
                        },
                        "required": [
                          "type",
                          "text"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "song_request"
                          },
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                          }
                        },
                        "required": [
                          "type",
                          "title"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "trigger",
                  "action"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "position": {
          "default": {
            "x": 80,
            "y": 80,
            "displayId": ""
          },
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "displayId": {
              "default": "",
              "type": "string"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "scale": {
          "default": 1,
          "type": "number",
          "minimum": 0.6,
          "maximum": 2
        },
        "dragBehavior": {
          "default": "stick",
          "type": "string",
          "enum": [
            "stick",
            "glide",
            "gravity"
          ]
        },
        "characterId": {
          "default": "blue-whale-maid",
          "type": "string"
        },
        "mcpEndpointId": {
          "default": "default",
          "type": "string"
        },
        "powerSaverEnabled": {
          "default": true,
          "type": "boolean"
        },
        "shortcutHideEnabled": {
          "default": true,
          "type": "boolean"
        },
        "autoHideFullscreen": {
          "default": true,
          "type": "boolean"
        },
        "dockToGame": {
          "default": true,
          "type": "boolean"
        },
        "sfxEnabled": {
          "default": true,
          "type": "boolean"
        },
        "sfxVolume": {
          "default": 0.7,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "followFrontApp": {
          "default": false,
          "type": "boolean"
        },
        "windowLayer": {
          "default": "always",
          "type": "string",
          "enum": [
            "always",
            "follow-ai",
            "normal"
          ]
        },
        "bubbleFontScale": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.7,
              "maximum": 1.6
            },
            {
              "type": "null"
            }
          ]
        },
        "bubbleFontId": {
          "default": "shangshou-gummy",
          "type": "string",
          "enum": [
            "shangshou-gummy",
            "handwriting",
            "rounded",
            "formal"
          ]
        },
        "patrolEnabled": {
          "default": true,
          "type": "boolean"
        },
        "notebookFontId": {
          "default": "auto",
          "type": "string"
        },
        "randomEggEnabled": {
          "default": true,
          "type": "boolean"
        },
        "peakOutfitEnabled": {
          "default": false,
          "type": "boolean"
        },
        "peakOutfitDay": {
          "default": "crosspet-deepseek",
          "type": "string"
        },
        "peakOutfitOffPeak": {
          "default": "crosspet-deepseek-pajamas",
          "type": "string"
        },
        "voiceEngineTier": {
          "default": "commercial_default",
          "type": "string",
          "enum": [
            "commercial_default",
            "offline_preferred"
          ]
        },
        "voiceCommercialProvider": {
          "default": "mimo-tts-voiceclone",
          "type": "string",
          "enum": [
            "minimax-tts",
            "openai-compatible-tts",
            "openrouter-tts",
            "mimo-tts",
            "mimo-tts-voiceclone",
            "mimo-tts-voicedesign"
          ]
        },
        "voiceOpenRouterModel": {
          "default": "google/gemini-3.8-flash-tts",
          "type": "string",
          "minLength": 1
        },
        "voiceMimoBuiltinVoice": {
          "default": "mimo_default",
          "type": "string",
          "minLength": 1
        },
        "voiceCloudFallbackPolicy": {
          "default": "subtitle_only",
          "type": "string",
          "enum": [
            "subtitle_only",
            "system_say"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
