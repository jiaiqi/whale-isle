{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PetDesktopPrefs",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/PetDesktopPrefs",
  "$defs": {
    "PetDesktopPrefs": {
      "type": "object",
      "properties": {
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "displayId": {
              "type": "string",
              "default": ""
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false,
          "default": {
            "x": 80,
            "y": 80,
            "displayId": ""
          }
        },
        "scale": {
          "type": "number",
          "minimum": 0.6,
          "maximum": 2,
          "default": 1
        },
        "dragBehavior": {
          "type": "string",
          "enum": [
            "stick",
            "glide",
            "gravity"
          ],
          "default": "stick"
        },
        "characterId": {
          "type": "string",
          "default": "blue-whale-maid"
        },
        "mcpEndpointId": {
          "type": "string",
          "default": "default"
        }
      },
      "additionalProperties": false
    }
  }
}
