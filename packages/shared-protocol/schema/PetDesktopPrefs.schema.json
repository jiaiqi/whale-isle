{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PetDesktopPrefs",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/PetDesktopPrefs",
  "$defs": {
    "PetDesktopPrefs": {
      "type": "object",
      "properties": {
        "position": {
          "default": {
            "x": 80,
            "y": 80,
            "displayId": ""
          },
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "displayId": {
              "default": "",
              "type": "string"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "scale": {
          "default": 1,
          "type": "number",
          "minimum": 0.6,
          "maximum": 2
        },
        "dragBehavior": {
          "default": "stick",
          "type": "string",
          "enum": [
            "stick",
            "glide",
            "gravity"
          ]
        },
        "characterId": {
          "default": "blue-whale-maid",
          "type": "string"
        },
        "mcpEndpointId": {
          "default": "default",
          "type": "string"
        },
        "powerSaverEnabled": {
          "default": true,
          "type": "boolean"
        },
        "shortcutHideEnabled": {
          "default": true,
          "type": "boolean"
        },
        "autoHideFullscreen": {
          "default": true,
          "type": "boolean"
        },
        "sfxEnabled": {
          "default": true,
          "type": "boolean"
        },
        "sfxVolume": {
          "default": 0.7,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "followFrontApp": {
          "default": false,
          "type": "boolean"
        },
        "windowLayer": {
          "default": "always",
          "type": "string",
          "enum": [
            "always",
            "follow-ai",
            "normal"
          ]
        },
        "bubbleFontScale": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.7,
              "maximum": 1.6
            },
            {
              "type": "null"
            }
          ]
        },
        "bubbleFontId": {
          "default": "shangshou-gummy",
          "type": "string",
          "enum": [
            "shangshou-gummy",
            "handwriting",
            "rounded",
            "formal"
          ]
        },
        "patrolEnabled": {
          "default": true,
          "type": "boolean"
        },
        "notebookFontId": {
          "default": "auto",
          "type": "string"
        },
        "randomEggEnabled": {
          "default": true,
          "type": "boolean"
        },
        "peakOutfitEnabled": {
          "default": false,
          "type": "boolean"
        },
        "peakOutfitDay": {
          "default": "crosspet-deepseek",
          "type": "string"
        },
        "peakOutfitOffPeak": {
          "default": "crosspet-deepseek-pajamas",
          "type": "string"
        },
        "voiceEngineTier": {
          "default": "commercial_default",
          "type": "string",
          "enum": [
            "commercial_default",
            "offline_preferred"
          ]
        },
        "voiceCommercialProvider": {
          "default": "mimo-tts",
          "type": "string",
          "enum": [
            "minimax-tts",
            "openai-compatible-tts",
            "openrouter-tts",
            "mimo-tts",
            "mimo-tts-voiceclone",
            "mimo-tts-voicedesign"
          ]
        },
        "voiceOpenRouterModel": {
          "default": "google/gemini-3.8-flash-tts",
          "type": "string",
          "minLength": 1
        },
        "voiceMimoBuiltinVoice": {
          "default": "mimo_default",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
