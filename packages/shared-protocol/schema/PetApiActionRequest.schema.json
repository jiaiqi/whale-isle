{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PetApiActionRequest",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/PetApiActionRequest",
  "$defs": {
    "PetApiActionRequest": {
      "type": "object",
      "properties": {
        "actionState": {
          "type": "string",
          "enum": [
            "idle",
            "walk",
            "eat_rice",
            "happy_maid",
            "thinking_tail_wag",
            "rage_spray",
            "clumsy_panic",
            "game_focus",
            "sing_stage",
            "hungry_lazy",
            "sleep_mute"
          ]
        },
        "durationMs": {
          "default": 6000,
          "type": "integer",
          "minimum": 500,
          "maximum": 60000
        }
      },
      "required": [
        "actionState"
      ],
      "additionalProperties": false
    }
  }
}
