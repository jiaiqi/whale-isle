{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TeamGoal",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/TeamGoal",
  "$defs": {
    "TeamGoal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "gameId": {
          "type": "string",
          "enum": [
            "stardew",
            "terraria",
            "dst"
          ]
        },
        "metrics": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "current": {
                "type": "number"
              },
              "target": {
                "type": "number"
              },
              "unit": {
                "default": "",
                "type": "string"
              },
              "source": {
                "default": "manual",
                "type": "string",
                "enum": [
                  "manual",
                  "team_money",
                  "shared_wood"
                ]
              }
            },
            "required": [
              "label",
              "current",
              "target"
            ],
            "additionalProperties": false
          }
        },
        "deadline": {
          "default": "",
          "type": "string"
        },
        "status": {
          "default": "active",
          "type": "string",
          "enum": [
            "active",
            "completed",
            "paused"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "gameId"
      ],
      "additionalProperties": false
    }
  }
}
