{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelProviderConfig",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/ModelProviderConfig",
  "$defs": {
    "ModelProviderConfig": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "OFFICIAL_LLM",
            "AGGREGATOR_LLM",
            "LOCAL_LLM",
            "AUDIO_TTS",
            "AUDIO_SVC"
          ]
        },
        "activeRegion": {
          "type": "string",
          "enum": [
            "CN",
            "GLOBAL",
            "LOCAL"
          ],
          "default": "CN"
        },
        "activePlanType": {
          "type": "string",
          "enum": [
            "PAY_AS_YOU_GO",
            "CODING_PLAN",
            "FREE_TIER",
            "LOCAL_GPU"
          ],
          "default": "PAY_AS_YOU_GO"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "region": {
                "type": "string",
                "enum": [
                  "CN",
                  "GLOBAL",
                  "LOCAL"
                ]
              },
              "planType": {
                "type": "string",
                "enum": [
                  "PAY_AS_YOU_GO",
                  "CODING_PLAN",
                  "FREE_TIER",
                  "LOCAL_GPU"
                ]
              },
              "baseUrl": {
                "type": "string",
                "format": "uri"
              },
              "isFullUrl": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "region",
              "planType",
              "baseUrl"
            ],
            "additionalProperties": false
          }
        },
        "apiKeyMaskedOrRef": {
          "type": "string"
        },
        "activeModelId": {
          "type": "string",
          "default": ""
        },
        "customParams": {
          "type": "object",
          "additionalProperties": {}
        },
        "discoveredModels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "supportsReasoningThink": {
                "type": "boolean",
                "default": false
              },
              "supportsVision": {
                "type": "boolean",
                "default": false
              },
              "supportsToolCalling": {
                "type": "boolean",
                "default": true
              },
              "inputCostPer1M": {
                "type": "number",
                "minimum": 0,
                "default": 0
              },
              "outputCostPer1M": {
                "type": "number",
                "minimum": 0,
                "default": 0
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "variants",
        "apiKeyMaskedOrRef",
        "discoveredModels"
      ],
      "additionalProperties": false
    }
  }
}
