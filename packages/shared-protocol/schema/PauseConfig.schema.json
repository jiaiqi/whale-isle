{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PauseConfig",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/PauseConfig",
  "$defs": {
    "PauseConfig": {
      "type": "object",
      "properties": {
        "periodMs": {
          "default": 340,
          "type": "integer",
          "minimum": 50,
          "maximum": 2000
        },
        "commaMs": {
          "default": 150,
          "type": "integer",
          "minimum": 20,
          "maximum": 2000
        },
        "ellipsisMs": {
          "default": 460,
          "type": "integer",
          "minimum": 50,
          "maximum": 3000
        }
      },
      "additionalProperties": false
    }
  }
}
