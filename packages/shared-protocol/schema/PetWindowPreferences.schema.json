{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PetWindowPreferences",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/PetWindowPreferences",
  "$defs": {
    "PetWindowPreferences": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string",
          "minLength": 1
        },
        "characterId": {
          "default": "blue-whale-maid",
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "displayId": {
              "default": "",
              "type": "string"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "scale": {
          "default": 1,
          "type": "number",
          "minimum": 0.6,
          "maximum": 2
        },
        "locked": {
          "default": false,
          "type": "boolean"
        },
        "visible": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "agentId",
        "position"
      ],
      "additionalProperties": false
    }
  }
}
