{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TtsEmotionTuningParams",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/TtsEmotionTuningParams",
  "$defs": {
    "TtsEmotionTuningParams": {
      "type": "object",
      "properties": {
        "emotionTag": {
          "type": "string",
          "enum": [
            "sweet_normal",
            "tsundere_refuse",
            "rage_spray",
            "lazy_yawn",
            "happy_rice"
          ]
        },
        "refAudioPath": {
          "default": "",
          "type": "string"
        },
        "refText": {
          "type": "string",
          "minLength": 1
        },
        "refAssetKind": {
          "default": "real_voice",
          "type": "string",
          "enum": [
            "real_voice",
            "stub_sine",
            "missing"
          ]
        },
        "speed": {
          "default": 1,
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.4
        },
        "temperature": {
          "default": 1,
          "type": "number",
          "minimum": 0.1,
          "maximum": 1
        },
        "topP": {
          "default": 1,
          "type": "number",
          "minimum": 0.1,
          "maximum": 1
        },
        "topK": {
          "default": 15,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "pauseConfig": {
          "default": {},
          "type": "object",
          "properties": {
            "periodMs": {
              "default": 340,
              "type": "integer",
              "minimum": 50,
              "maximum": 2000
            },
            "commaMs": {
              "default": 150,
              "type": "integer",
              "minimum": 20,
              "maximum": 2000
            },
            "ellipsisMs": {
              "default": 460,
              "type": "integer",
              "minimum": 50,
              "maximum": 3000
            }
          },
          "additionalProperties": false
        },
        "prependSfxPath": {
          "default": "",
          "type": "string"
        },
        "sfxVolume": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "emotionTag",
        "refText"
      ],
      "additionalProperties": false
    }
  }
}
