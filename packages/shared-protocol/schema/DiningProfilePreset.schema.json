{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DiningProfilePreset",
  "contractVersion": "1.0.0",
  "$ref": "#/$defs/DiningProfilePreset",
  "$defs": {
    "DiningProfilePreset": {
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "enum": [
            "BUDGET_SLACKING",
            "DELUXE_LIVESTREAM",
            "OFFLINE_SURVIVAL"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "roleBindings": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "MAIN_PERSONA_BRAIN",
              "STARDEW_GAME_PLANNER",
              "TERRARIA_GAME_PLANNER",
              "DST_GAME_PLANNER",
              "DANMAKU_FAST_ROUTER",
              "VISION_STORYBOARD",
              "VOICE_TTS_SPEECH",
              "VOICE_SVC_SINGING"
            ]
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "secretMaskingEnabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "profileId",
        "displayName",
        "roleBindings"
      ],
      "additionalProperties": false
    }
  }
}
