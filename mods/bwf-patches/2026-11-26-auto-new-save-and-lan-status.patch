+        private static ulong AllocateUniqueSaveId()
+        {
+            for (int attempt = 0; attempt < 32; attempt++)
+            {
+                ulong candidate = (ulong)Random.Shared.Next(100_000_000, 999_999_999);
+                bool collision = false;
+                if (Directory.Exists(Constants.SavesPath))
+                {
+                    string suffix = "_" + candidate;
+                    foreach (string dir in Directory.GetDirectories(Constants.SavesPath))
+                    {
+                        if (Path.GetFileName(dir).EndsWith(suffix, StringComparison.Ordinal))
+                        {
+                            collision = true;
+                            break;
+                        }
+                    }
+                }
+                if (!collision)
+                    return candidate;
+            }
+            return (ulong)DateTimeOffset.UtcNow.ToUnixTimeSeconds();
+        }
