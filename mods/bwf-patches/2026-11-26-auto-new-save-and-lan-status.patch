+        /// <summary>同步星露谷当前语言码（避免全新隔离目录缺少 startup_preferences 时回退英文）。在主线程上调用。</summary>
+        internal bool EnsureLanguage(string code)
+        {
+            if (string.IsNullOrWhiteSpace(code))
+                return false;
+            if (!Utility.TryParseEnum<LocalizedContentManager.LanguageCode>(code.Trim(), out var parsed)
+                || parsed == LocalizedContentManager.LanguageCode.mod)
+            {
+                return false;
+            }
+            if (LocalizedContentManager.CurrentLanguageCode != parsed)
+            {
+                LocalizedContentManager.CurrentLanguageCode = parsed;
+                Monitor.Log($"已同步游戏语言：{parsed}", LogLevel.Info);
+            }
+            if (Game1.activeClickableMenu is TitleMenu tm && tm.startupPreferences != null)
+            {
+                tm.startupPreferences.languageCode = parsed.ToString();
+                if (tm.startupPreferences.isLoaded)
+                    tm.startupPreferences.savePreferences(async: false, update_language_from_ingame_language: true);
+            }
+            return true;
+        }
