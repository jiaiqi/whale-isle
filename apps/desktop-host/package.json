{
  "name": "@workbench/desktop-host",
  "productName": "鲸屿",
  "version": "0.2.0-dev.1",
  "private": true,
  "description": "鲸屿 Whale Isle · Electron 跨平台宿主（透明桌宠 / AI 自治 / 直播中控台 / WebUI）",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -b && node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron dist/main/index.js",
    "package": "pnpm build && pnpm build:avatar-mod && electron-builder",
    "build:avatar-mod": "node ../../tools/scripts/build-avatar-mod.mjs"
  },
  "build": {
    "appId": "com.whaleisle.desktop",
    "productName": "鲸屿 Whale Isle",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../guide-forager",
        "to": "guide-forager"
      },
      {
        "from": "../../packages/shared-protocol/fixtures/blue-whale-maid.json",
        "to": "persona/blue-whale-maid.json"
      },
      {
        "from": "../../assets/pet-packs",
        "to": "pet-packs"
      },
      {
        "from": "../../tools/hooks",
        "to": "hooks"
      },
      {
        "from": "../../mods/stardew-avatar-sync/publish",
        "to": "mods/WhaleIsleAvatar"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/brand/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/brand/icon.ico"
    }
  },
  "dependencies": {
    "@workbench/agent-harness": "workspace:*",
    "@workbench/character-core": "workspace:*",
    "@workbench/game-bridge-mcp": "workspace:*",
    "@workbench/live-stream-hub": "workspace:*",
    "@workbench/local-store": "workspace:*",
    "@workbench/memory-graph": "workspace:*",
    "@workbench/model-gateway": "workspace:*",
    "@workbench/persona-brain": "workspace:*",
    "@workbench/pet-renderer": "workspace:*",
    "@workbench/plugin-kit": "workspace:*",
    "@workbench/runtime-core": "workspace:*",
    "@workbench/shared-protocol": "workspace:*",
    "@workbench/stardew-mods": "workspace:*",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cmdk": "^1.1.1",
    "electron": "^45.4.1",
    "esbuild": "^0.25.0",
    "lucide-react": "^1.77.0",
    "playwright-core": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-force-graph-2d": "^1.29.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.1.13"
  }
}
